# SportX on a server that already hosts another site.
#
# This file only ADDS two server blocks for its own subdomains. Nothing here
# touches the existing site's config, its port 80/443 blocks, or the default
# server — install it as a new file and reload (never restart) nginx:
#
#   sudo cp deploy/nginx/sportx.conf.sample /etc/nginx/sites-available/sportx.conf
#   sudo ln -s /etc/nginx/sites-available/sportx.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Replace game.example.com / admin.example.com with your subdomains, then add TLS:
#   sudo certbot --nginx -d game.example.com -d admin.example.com
# (certbot edits only the blocks for those names.)

upstream sportx_backend {
    server 127.0.0.1:8010;   # must match ExecStart in sportx-api.service
    keepalive 16;
}

# --- Player site ---
server {
    listen 80;
    listen [::]:80;
    server_name game.example.com;

    root /var/www/sportx/user;
    index index.html;

    access_log /var/log/nginx/sportx-user.access.log;
    error_log  /var/log/nginx/sportx-user.error.log;

    client_max_body_size 2m;

    location /api/ {
        proxy_pass http://sportx_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location /ws {
        proxy_pass http://sportx_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    # hashed build assets never change under the same name
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# --- Admin console ---
server {
    listen 80;
    listen [::]:80;
    server_name admin.example.com;

    root /var/www/sportx/admin;
    index index.html;

    access_log /var/log/nginx/sportx-admin.access.log;
    error_log  /var/log/nginx/sportx-admin.error.log;

    location /api/ {
        proxy_pass http://sportx_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws {
        proxy_pass http://sportx_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
