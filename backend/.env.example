# ---- Application ----
APP_NAME=SportX
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ---- Server ----
HOST=0.0.0.0
PORT=8000

# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=sportx

# ---- Security / JWT ----
# Generate a strong secret, e.g. python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS (comma separated origins) ----
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# ---- Providers ----
# SPORTS_PROVIDER=theodds pulls live fixtures/odds from the-odds-api.com and needs
# SPORTS_API_KEY. Odds calls cost usage credits (free plan: 500/month) — responses
# are cached server-side, and if the key is missing/expired/out of credits the API
# serves the seeded demo board instead (visible as a DEMO ODDS badge in the UI).
SPORTS_PROVIDER=mock
GAMES_PROVIDER=mock
SPORTS_API_KEY=

# proexch feed (Betfair-style: back/lay, fancy, live score, settlement results).
# No API key — the vendor whitelists your SERVER IP and domain, so the backend has
# to run on that server and send the approved domain as Origin/Referer.
PROEXCH_BASE_URL=https://apidata.proexch.in
PROEXCH_ORIGIN=https://your-domain.com

# ---- Bootstrap super admin (created by scripts/seed_data.py) ----
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=ChangeMe123!
SUPERADMIN_FULLNAME=Platform Owner
SUPERADMIN_INITIAL_CREDITS=1000000
